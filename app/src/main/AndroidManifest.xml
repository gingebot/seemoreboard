<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".SeeMoreBoardApplication"
        android:allowBackup="true"
        android:label="SeeMoreBoard"
        android:supportsRtl="true">

        <service
            android:name=".ime.service.SeeMoreBoardService"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
            <meta-data
                android:name="android.view.im.settingsActivity"
                android:value="com.lowvision.keyboard.ui.settings.SettingsActivity" />
        </service>

        <activity
            android:name="com.lowvision.keyboard.ui.settings.SettingsActivity"
            android:exported="true"
            android:label="SeeMoreBoard Settings" />

    </application>

</manifest>